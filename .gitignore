# Gradle files
.gradle/
.kotlin/
build/
!patches/src/main/kotlin/app/morphe/patches/all/misc/build/
!patches/src/main/kotlin/app/morphe/patches/all/misc/build/**

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# NPM modules
node_modules/

# Python bytecode caches. Importing scripts/gen-l10n.py from another script writes one, and an
# untracked directory appearing mid-run is enough to fail the in-place pre-push gate.
__pycache__/
*.pyc

# Local CodeGraph index
.codegraph/

# Local copy of upstream ReVanced sources (do not commit)
revanced-patches/

# Local working notes
CLAUDE.md
CODEX_CHANGELOG.md
.claude/

# Research notes (regenerated by research passes)
RESEARCH.md
Roadmap_Blocked.md

# Keep working documents local; publish usage and release notes.
*.md
!README.md
!CHANGELOG.md
morphe-signing.key
